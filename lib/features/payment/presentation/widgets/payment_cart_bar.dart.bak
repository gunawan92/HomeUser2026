import 'package:flutter/material.dart';

import '../../../../core/utils/currency_formatter.dart';
import '../../../../design_system/tokens/stela_colors.dart';
import '../../../../design_system/tokens/stela_spacing.dart';
import '../../domain/payment_models.dart';

class PaymentCartBar extends StatelessWidget {
  const PaymentCartBar({super.key, required this.items, required this.onTap});
  final List<PaymentItem> items;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    final total = items.fold(0, (sum, item) => sum + item.amount);
    return SafeArea(
      top: false,
      child: Padding(
        padding: const EdgeInsets.all(StelaSpacing.md),
        child: FilledButton.icon(
          onPressed: onTap,
          icon: const Icon(Icons.shopping_bag_outlined),
          label: Row(
            children: [
              Expanded(child: Text('${items.length} tagihan dipilih')),
              Text(CurrencyFormatter.rupiah(total)),
            ],
          ),
          style: FilledButton.styleFrom(
            minimumSize: const Size.fromHeight(56),
            backgroundColor: StelaColors.primaryRed,
          ),
        ),
      ),
    );
  }
}
